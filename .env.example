# SR CODE LABS - Environment Variables Example
# Copy this file to .env.local for local testing, or set these variables in your deployment dashboard (e.g., Vercel / Netlify).
# NEVER commit your actual API keys or secrets to Git!

# Resend API Key (Generate at https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination inbox where customer inquiries are routed
CONTACT_TO_EMAIL=info@srcodelab.space

# Sender address:
# - For testing before domain verification: "SR CODE LABS <onboarding@resend.dev>"
# - Once your domain "srcodelab.space" is verified in Resend: "SR CODE LABS <contact@srcodelab.space>"
CONTACT_FROM_EMAIL=SR CODE LABS <onboarding@resend.dev>

# Optional: Local server port (default 5000)
PORT=5000
